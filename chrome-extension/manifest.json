{
  "manifest_version": 3,
  "name": "ReelPick for streaming",
  "description": "Add films from MUBI, Prime Video, Netflix, and Max to ReelPick.",
  "version": "1.1.1",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.mubi.com/*",
    "https://*.primevideo.com/*",
    "https://*.netflix.com/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "https://*.amazon.es/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.in/*",
    "https://*.amazon.it/*",
    "https://*.amazon.co.jp/*",
    "https://movie-picker-lyart.vercel.app/*"
  ],
  "action": {
    "default_title": "Add this streaming film to ReelPick",
    "default_popup": "popup.html"
  }
}
